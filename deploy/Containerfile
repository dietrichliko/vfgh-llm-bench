# bench: web application and worker (same image)
#   podman build --format docker -f deploy/Containerfile \
#     --build-arg GIT_COMMIT=$(git rev-parse HEAD) -t localhost/bench .
# (--format docker keeps the HEALTHCHECK; the OCI format has none. compose.yaml defines
# the same check, so it applies there either way.)

FROM docker.io/library/python:3.13-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src/ ./src/
RUN uv sync --frozen --no-dev --no-editable

FROM docker.io/library/python:3.13-slim
# commit of the code in the image; recorded in the frozen protocol (environment.yaml)
ARG GIT_COMMIT=""
LABEL org.opencontainers.image.source="https://github.com/dietrichliko/vfgh-llm-bench" \
      org.opencontainers.image.revision="${GIT_COMMIT}"
# git, ssh: the app pushes frozen protocols and results to the study repository (stage 6d)
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 bench \
    && mkdir -p /data /config \
    && chown bench:bench /data
COPY --from=build /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYDANTIC_AI_NO_BANNER=1 \
    BENCH_DATA_DIR=/data \
    BENCH_CONFIG=/config/providers.yaml \
    BENCH_SECRETS_DIR=/run/secrets \
    BENCH_GIT_COMMIT=${GIT_COMMIT}
USER bench
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=60s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["bench", "serve", "--port", "8000"]
